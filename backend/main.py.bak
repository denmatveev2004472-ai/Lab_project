SELECT id, item_id, user_name, start_time, end_time, notes, created_at
FROM equipment_usage
WHERE item_id = :item_id AND start_time >= :start AND end_time <= :end
ORDER BY start_time
    """), {"item_id": item_id, "start": start, "end": end}).fetchall()
